# --- Database Configuration ---
DATABASE_URL=postgresql://postgres:password@localhost:5432/momentum_db
# standalone TimescaleDB VM host
DB_HOST=192.168.1.100 
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_secure_password
DB_NAME=momentum_db

# --- KIS (Korea Investment & Securities) API ---
KIS_APP_KEY=your_kis_app_key
KIS_APP_SECRET=your_kis_app_secret
KIS_CANO=your_kis_account_number
KIS_ACNT_PRDT_CD=01
KIS_REST_BASE_URL=https://openapi.koreainvestment.com:9443

# --- Prefect Configuration ---
PREFECT_API_URL=http://your-prefect-server:4200/api
PREFECT_API_KEY=your_prefect_api_key
WORKER_POOL_NAME=momentum-worker-pool

# --- General Settings ---
LOG_LEVEL=INFO
MIN_HISTORY_ROWS=100
